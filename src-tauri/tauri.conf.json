{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Cloud-Freelife",
  "version": "1.7.0",
  "identifier": "app.cloudfreelife.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://127.0.0.1:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "Project D.R.E.A.M: Cloud Sonata",
        "width": 1320,
        "height": 840,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "resizable": true,
        "backgroundColor": "#eaf3fb"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; style-src-attr 'unsafe-inline'; script-src 'self'; font-src 'self' data:; media-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Entertainment",
    "shortDescription": "Calm pastel coloring, drawing and mini-games",
    "longDescription": "Cloud-Freelife is a relaxing pastel coloring and free-drawing app with a few calm mini-games. Works fully offline.",
    "copyright": "Cloud-Freelife contributors",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false,
        "languages": ["English"]
      }
    }
  }
}
