{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Minimal permissions for Cloud-Freelife: its own data folder, save dialogs, GitHub links and GitHub HTTPS requests.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "core:webview:allow-set-webview-zoom",
    "core:window:allow-is-minimized",
    "core:window:allow-close",
    "dialog:allow-save",
    "dialog:allow-message",
    "dialog:allow-ask",
    {
      "identifier": "opener:allow-open-url",
      "allow": [{ "url": "https://github.com/*" }, { "url": "https://github.com/**" }]
    },
    "opener:allow-reveal-item-in-dir",
    {
      "identifier": "opener:allow-open-path",
      "allow": [{ "path": "$DATA/Cloud-Freelife" }, { "path": "$DATA/Cloud-Freelife/**" }]
    },
    {
      "identifier": "fs:scope",
      "allow": [
        { "path": "$DATA/Cloud-Freelife" },
        { "path": "$DATA/Cloud-Freelife/**" },
        { "path": "$DOWNLOAD/Cloud-Freelife" },
        { "path": "$DOWNLOAD/Cloud-Freelife/**" }
      ]
    },
    "fs:allow-exists",
    "fs:allow-mkdir",
    "fs:allow-read-dir",
    "fs:allow-read-file",
    "fs:allow-write-file",
    "fs:allow-remove",
    "fs:allow-rename",
    {
      "identifier": "http:default",
      "allow": [
        { "url": "https://api.github.com/*" },
        { "url": "https://github.com/*" },
        { "url": "https://objects.githubusercontent.com/*" },
        { "url": "https://release-assets.githubusercontent.com/*" },
        { "url": "https://github-releases.githubusercontent.com/*" }
      ]
    }
  ]
}
