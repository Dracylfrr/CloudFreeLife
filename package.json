{
  "name": "cloud-freelife",
  "private": true,
  "version": "2.0.2",
  "description": "Cloud-Freelife - a calm pastel coloring, drawing and mini-game app for Windows.",
  "type": "module",
  "scripts": {
    "dev": "node scripts/copy-tts.mjs && vite",
    "build": "node scripts/copy-tts.mjs && vite build",
    "preview": "vite preview",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "content:generate": "node scripts/generate-content.mjs",
    "content:pack": "node scripts/pack-content.mjs",
    "icons": "node scripts/make-icons.mjs",
    "tauri": "tauri",
    "package:win": "node scripts/package-windows.mjs"
  },
  "license": "MIT",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@tauri-apps/cli": "^2.12.6",
    "@types/node": "^26.6.6",
    "jsdom": "^31.0.1",
    "sharp": "^0.35.5",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "typescript": "^6.0.3",
    "vite": "^8.3.8",
    "vitest": "^5.1.1"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.5",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-fs": "^2.7.1",
    "@tauri-apps/plugin-http": "^2.9.0",
    "@tauri-apps/plugin-opener": "^2.7.3",
    "onnxruntime-web": "1.22.0",
    "phonemizer": "1.2.1"
  }
}
